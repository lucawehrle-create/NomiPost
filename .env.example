# NomiPost Landingpage – Umgebungsvariablen
#
# Kopiere diese Datei nach `.env.local` und fülle die Werte aus.
# Ohne diese Werte läuft die Seite zwar, aber:
#   - Supabase: Fallback auf lokale JSON-Datei (data/waitlist.json)
#   - Admin-Passwort: Admin-Bereich bleibt gesperrt bis ein Passwort gesetzt ist
#   - Mail-Versand: Fallback auf Console-Log (Dev-Modus zeigt Link direkt)

# --- Supabase (empfohlen für Produktion) ----------------------
# Erstelle ein kostenloses Projekt auf https://supabase.com
# WICHTIG: Wähle eine EU-Region (z. B. eu-central-1 / Frankfurt),
# damit die Daten im DSGVO-Geltungsbereich bleiben.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Admin-Bereich --------------------------------------------
# Passwort für /admin. Mindestens 8 Zeichen.
# WICHTIG: Nicht ins Repo committen – nur in .env.local!
ADMIN_PASSWORD=

# --- Mail-Versand für Double-Opt-In (Pflicht vor Go-Live) -----
# Kostenloser Account auf https://resend.com (3000 Mails/Monat gratis)
# Ohne Resend-Key läuft der Mail-Versand im Dev-Modus:
# Der Bestätigungs-Link wird im Server-Log und in der API-Response
# angezeigt, damit man ohne echten Mail-Service testen kann.
#
# In PRODUKTION ist dieser Key zwingend nötig – ohne DOI-Mail-Versand
# ist die Seite NICHT rechtssicher einsetzbar (§ 7 Abs. 2 UWG).
RESEND_API_KEY=

# Absender-Adresse für Bestätigungs-Mails – muss bei Resend verifiziert sein
MAIL_FROM="NomiPost <no-reply@nomipost.de>"
MAIL_REPLY_TO="hallo@nomipost.de"
